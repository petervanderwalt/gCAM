{
  "name": "gcam-react",
  "private": true,
  "version": "0.1.0",
  "description": "gCAM — Sienci Labs g-code generator (React port, gSender-styled)",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --port 5174 --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5174",
    "test": "jest --config jest.config.cjs --verbose",
    "test:watch": "jest --watch --config jest.config.cjs  --verbose",
    "lint": "biome check --formatter-enabled=false .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "classnames": "^2.5.1",
    "lucide-react": "^0.428.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-variants": "^0.2.1",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@biomejs/biome": "2.5.11",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^30.0.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.4.6",
    "typescript": "^5.4.5",
    "vite": "^5.4.2",
    "vite-tsconfig-paths": "^5.0.1"
  }
}
